---
import Layout from "@/layouts/Layout.astro";
// Styles belong to the page, never to a JS island: a lazily loaded chunk that
// carried CSS would re-inject it later and override the theme (see docs/ARCHITECTURE.md).
import "@/web/styles/base.css";
import "@/web/themes/reference/theme.css";
import ReferenceDeck from "@/web/themes/reference";
import { getCv } from "@/core";
import { buildDeckModel } from "@/bff/web/deck";
import { buildReferenceView } from "@/bff/web/themes/reference";

const cv = getCv();
---

<Layout theme="reference">
  <ReferenceDeck client:load deck={buildDeckModel(cv)} view={buildReferenceView(cv)} />
</Layout>
