---
import Layout from "@/layouts/Layout.astro";
// Styles belong to the page, never to a JS island: a lazily loaded chunk that
// carried CSS would re-inject it later and override the theme (see docs/ARCHITECTURE.md).
import "@/web/styles/base.css";
import "@/web/themes/git/theme.css";
import GitDeck from "@/web/themes/git";
import { getCv } from "@/core";
import { buildDeckModel } from "@/bff/web/deck";
import { buildGitView } from "@/bff/web/themes/git";

const cv = getCv();
---

<Layout theme="git">
  <GitDeck client:load deck={buildDeckModel(cv)} view={buildGitView(cv)} />
</Layout>
