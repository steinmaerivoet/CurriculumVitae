---
import { getCv } from "@/core";
import { files, qrSlug } from "@/bff/shared/files";

// Downloads a styled QR code that points to this site. Shown in the bottom-right
// corner by Downloads.astro; the PNG is generated at build time by src/pages/[file].png.ts
// (an SVG version sits next to it, see src/pages/[file].svg.ts).
const cv = getCv();
const label = cv.ui.downloadQr;
---

<a
  href={files(cv).qrPng}
  download={`${qrSlug(cv)}.png`}
  aria-label={`${label} (PNG)`}
  title={`${label} (PNG)`}
  class="download-qr group pointer-events-auto flex h-10 items-center rounded-full border border-line bg-bg/70 text-fg/90 backdrop-blur-md transition-colors duration-500 hover:border-accent hover:bg-accent hover:text-on-accent"
>
  <span
    class="grid max-w-0 overflow-hidden text-xs font-medium tracking-wide whitespace-nowrap opacity-0 transition-all duration-500 ease-out-expo group-hover:max-w-40 group-hover:pl-4 group-hover:opacity-100 group-focus-visible:max-w-40 group-focus-visible:pl-4 group-focus-visible:opacity-100"
    aria-hidden="true"
  >
    {label}
  </span>
  <span class="grid size-10 shrink-0 place-items-center" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3.5" y="3.5" width="6" height="6" rx="1.5" />
      <rect x="14.5" y="3.5" width="6" height="6" rx="1.5" />
      <rect x="3.5" y="14.5" width="6" height="6" rx="1.5" />
      <path d="M14.5 14.5h.01M17.5 14.5h3M14.5 17.5v3M17.5 17.5h.01M20.5 20.5h.01M17.5 20.5h.01M20.5 17.5h.01" />
    </svg>
  </span>
</a>
