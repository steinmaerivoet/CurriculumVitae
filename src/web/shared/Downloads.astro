---
import DownloadCv from "./DownloadCv.astro";
import DownloadQr from "./DownloadQr.astro";

// Always-visible download buttons in the bottom-right corner, stacked so each
// label can open to the left without pushing the other button around.
---

<div
  class="downloads pointer-events-none fixed right-3 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-[45] flex flex-col items-end gap-2 sm:right-4 lg:right-7"
>
  <DownloadQr />
  <DownloadCv />
</div>

<style>
  /* Appear together with the rest of the deck chrome. */
  .downloads {
    animation: downloads-in 1s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
  }
  @keyframes downloads-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .downloads {
      animation: none;
    }
  }
</style>
