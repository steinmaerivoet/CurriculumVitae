---
import { getCv } from "@/core";
import { buildDownloads, type DownloadId } from "@/bff/web/downloads";

// The download buttons in the bottom-right corner, top to bottom: CV (PDF),
// QR code and share card (both PNG, see src/pages/[file].*.ts). At rest they
// are a quiet column of small logos. The one under the pointer (or in keyboard
// focus) grows into a pill with its label and format, and a preview of the
// file appears beside it. Previews load on the first interaction only.
const downloads = buildDownloads(getCv());

const icons: Record<DownloadId, string> = {
  cv: '<path d="M14 3.5H7.5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8z"/><path d="M14 3.5V8h4.5"/><path d="M9 12.5h6M9 16h4"/>',
  qr: '<rect x="3.5" y="3.5" width="6" height="6" rx="1.5"/><rect x="14.5" y="3.5" width="6" height="6" rx="1.5"/><rect x="3.5" y="14.5" width="6" height="6" rx="1.5"/><path d="M14.5 14.5h.01M17.5 14.5h3M14.5 17.5v3M17.5 17.5h.01M20.5 20.5h.01M17.5 20.5h.01M20.5 17.5h.01"/>',
  share: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M6 10h5M6 13.5h3.5"/><rect x="14" y="8.5" width="4.5" height="7" rx="1"/>',
};
---

<div class="downloads pointer-events-none fixed right-3 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-[45] flex flex-col items-end gap-2 sm:right-4 lg:right-7" data-downloads>
  {
    downloads.map((d) => (
      <div class={`dl-slot dl-${d.id}`} style={`--dl-ratio: ${d.preview.width} / ${d.preview.height}`}>
        <a href={d.href} download={d.filename} aria-label={`${d.label} (${d.detail})`} title={`${d.label} (${d.detail})`} class="dl">
          <span class="dl-logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[d.id]} />
          </span>
          <span class="dl-text" aria-hidden="true">
            <span class="dl-label">{d.label}</span>
            <span class="dl-detail">{d.detail}</span>
          </span>
          <span class="dl-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v10m0 0-4-4m4 4 4-4M6.5 19h11" />
            </svg>
          </span>
        </a>
        <span class="dl-preview" aria-hidden="true">
          <img data-src={d.preview.src} alt="" width={d.preview.width} height={d.preview.height} decoding="async" />
        </span>
      </div>
    ))
  }
</div>

<script>
  // Fetch the preview images on the first hover or focus, not with the page.
  const root = document.querySelector<HTMLElement>("[data-downloads]");
  const load = () => {
    root?.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
      img.src = img.dataset["src"] ?? "";
      img.removeAttribute("data-src");
    });
  };
  root?.addEventListener("pointerover", load, { once: true });
  root?.addEventListener("focusin", load, { once: true });
</script>

<style>
  .downloads {
    /* Resting size of a button, and its size when it grows. A theme can set
       --dl-radius (corners) and --dl-label-font. */
    --dl-size: 2.5rem;
    --dl-open: 13.5rem;
    --dl-open-h: 2.75rem;
    animation: downloads-in 1s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both;
  }
  @media (min-width: 640px) {
    .downloads {
      --dl-size: 2.25rem;
      --dl-open: 15rem;
    }
  }

  /* Each button sits in a fixed slot and grows out of it (left, and a little up
     and down into the gaps), so its neighbours never move. */
  .dl-slot {
    position: relative;
    width: var(--dl-size);
    height: var(--dl-size);
  }
  .dl-slot:hover,
  .dl-slot:focus-within {
    z-index: 1;
  }

  .dl {
    pointer-events: auto;
    position: absolute;
    top: 50%;
    right: 0;
    display: flex;
    align-items: center;
    width: var(--dl-size);
    height: var(--dl-size);
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--c-line) 80%, transparent);
    border-radius: var(--dl-radius, 0.8rem);
    background: color-mix(in oklab, var(--c-bg) 72%, transparent);
    color: var(--c-fg);
    translate: 0 -50%;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.4s;
  }

  .dl-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: calc(var(--dl-size) - 2px);
    height: 100%;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dl-logo svg {
    box-sizing: content-box;
    width: 16px;
    height: 16px;
    padding: 0.3rem;
    border-radius: calc(var(--dl-radius, 0.8rem) * 0.7);
    color: color-mix(in oklab, var(--c-fg) 62%, transparent);
    transition:
      color 0.3s,
      background-color 0.3s,
      width 0.5s,
      height 0.5s;
  }

  .dl-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .dl-label {
    font-family: var(--dl-label-font, inherit);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .dl-detail {
    font-family: var(--f-mono);
    font-size: 10.5px;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--c-mute);
  }
  .dl-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    color: var(--c-accent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .dl-arrow svg {
    width: 16px;
    height: 16px;
  }

  /* The preview: a small image of the file, beside the grown button and
     aligned with its bottom edge. Shown where a pointer can hover. */
  .dl-preview {
    pointer-events: none;
    position: absolute;
    right: calc(var(--dl-open) + 0.625rem);
    bottom: calc((var(--dl-size) - var(--dl-open-h)) / 2);
    width: var(--dl-preview-w, 9.5rem);
    padding: 0.375rem;
    border: 1px solid var(--c-line);
    border-radius: calc(var(--dl-radius, 0.8rem) * 0.9);
    background: var(--c-bg);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 40px -12px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px) scale(0.97);
    transform-origin: right bottom;
    transition:
      opacity 0.25s,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0.25s;
  }
  .dl-cv .dl-preview {
    --dl-preview-w: 12rem;
  }
  .dl-share .dl-preview {
    --dl-preview-w: 16rem;
  }
  .dl-preview img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--dl-ratio);
    border-radius: calc(var(--dl-radius, 0.8rem) * 0.55);
    background: color-mix(in oklab, var(--c-fg) 6%, transparent);
  }
  .dl-cv .dl-preview img {
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  /* Grown: under the pointer, or in keyboard focus. */
  @media (hover: hover) {
    .dl:hover {
      width: var(--dl-open);
      height: var(--dl-open-h);
    }
    .dl-slot:hover .dl-text,
    .dl-slot:hover .dl-arrow {
      opacity: 1;
      transition-delay: 0.1s;
    }
  }
  .dl:focus-visible {
    width: var(--dl-open);
    height: var(--dl-open-h);
  }
  .dl:focus-visible .dl-text,
  .dl:focus-visible .dl-arrow {
    opacity: 1;
  }
  .dl:hover,
  .dl:focus-visible {
    border-color: color-mix(in oklab, var(--c-accent) 70%, transparent);
    background: var(--c-bg);
    box-shadow: 0 10px 28px -12px rgb(0 0 0 / 0.35);
  }
  .dl:hover .dl-logo,
  .dl:focus-visible .dl-logo {
    width: calc(var(--dl-open-h) - 2px);
  }
  .dl:hover .dl-logo svg,
  .dl:focus-visible .dl-logo svg {
    color: var(--c-accent);
    background: color-mix(in oklab, var(--c-accent) 14%, transparent);
  }
  .dl:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (min-width: 768px) {
    .dl-slot:has(.dl:hover) .dl-preview {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.25s 0.08s,
        transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.08s,
        visibility 0s;
    }
  }
  @media (min-width: 768px) {
    .dl-slot:has(.dl:focus-visible) .dl-preview {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.25s,
        transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0s;
    }
  }

  @keyframes downloads-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .downloads {
      animation: none;
    }
    .dl,
    .dl-logo,
    .dl-text,
    .dl-arrow,
    .dl-preview {
      transition: none !important;
    }
  }
</style>
