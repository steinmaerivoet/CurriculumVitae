---
import { getCv } from "@/core";
import { buildPageMeta, buildStructuredData } from "@/bff/seo";
import { themeInfo, type ThemeId } from "@/web/themes/registry";
import Downloads from "@/web/shared/Downloads.astro";

/**
 * The page around a theme's deck: <head>, the theme attribute that switches
 * the design tokens, and the download buttons. Every theme page uses it.
 */
type Props = {
  theme: ThemeId;
  /** Font files the first slide needs: fetched with the HTML instead of after the CSS. */
  preloadFonts?: string[];
};
const { theme, preloadFonts = [] } = Astro.props;

const cv = getCv();
const { meta, person } = cv;
const info = themeInfo(theme);
const { title, description, canonical, image } = buildPageMeta(cv);
// The whole career as schema.org data: the slides only render the selected employer.
const structuredData = JSON.stringify(buildStructuredData(cv)).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={meta.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{theme === "plain" ? title : `${title} · ${info.label}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {info.themeColor.map((c) => <meta name="theme-color" content={c.color} media={"media" in c ? c.media : undefined} />)}
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/json" href="/api/v1/cv.json" title="CV as JSON" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={meta.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="profile:first_name" content={person.firstName} />
    <meta property="profile:last_name" content={person.lastName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image.url} />
    <script type="application/ld+json" set:html={structuredData} />

    <script is:inline>
      document.documentElement.classList.add("js");
      // A light/dark choice made earlier, applied before the first paint.
      try {
        var mode = localStorage.getItem("cv-mode");
        if (mode === "light" || mode === "dark") document.documentElement.dataset.mode = mode;
      } catch (e) {}
      // If the slideshow fails to start, show all content instead of leaving it hidden.
      setTimeout(function () {
        if (!document.documentElement.classList.contains("deck-ready")) {
          document.documentElement.classList.add("no-reveal");
        }
      }, 4000);
    </script>
  </head>
  <body>
    <slot />
    <Downloads />
    <noscript>
      <style>
        html, body { overflow: auto !important; height: auto !important; }
        [data-chrome] { opacity: 1 !important; }
      </style>
    </noscript>
  </body>
</html>
